# shellcheck shell=bash disable=SC2034
# =============================================================================
# PROVEX v2 - GCP configuration. Sourced by every script in infra/gcp/.
#
#  * Plain bash KEY=value. NO SECRETS here - this file is committed.
#  * Every value can be overridden for one command from the environment:
#        ZONE=us-central1-b ./create_gpu_vm.sh
#    or persistently in config.local.env next to this file (git-ignored).
# =============================================================================

_PROVEX_CFG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${_PROVEX_CFG_DIR}/config.local.env" ]]; then
  # shellcheck source=/dev/null
  source "${_PROVEX_CFG_DIR}/config.local.env"
fi

# ---- Local tooling (Windows Git Bash) ------------------------------------------
# Cloud SDK bin dir; lib.sh prepends it to PATH when it exists (gcloud is not on Git Bash's PATH).
GCLOUD_BIN_DIR="${GCLOUD_BIN_DIR:-/c/Users/ddhanuka/AppData/Local/Google/Cloud SDK/google-cloud-sdk/bin}"

# ---- Project & billing ---------------------------------------------------------
# Dedicated project (deleting it at the end = clean teardown, see down.sh --all).
PROJECT_ID="${PROJECT_ID:-provex-v2-dd1304}"
PROJECT_NAME="${PROJECT_NAME:-PROVEX v2}"
# Empty = use the billing account the project is already linked to (or the only open
# account when it is not linked yet). Put an explicit id in config.local.env if needed.
BILLING_ACCOUNT_ID="${BILLING_ACCOUNT_ID:-}"
# 1 = the billing account was upgraded from Free Trial to paid (GPUs need that; the
# remaining credit is kept). The PROVEX account is upgraded.
BILLING_UPGRADED="${BILLING_UPGRADED:-1}"
# Contact e-mail for quota requests. Empty = the active gcloud account.
CONTACT_EMAIL="${CONTACT_EMAIL:-}"

# ---- Credit window & budget ------------------------------------------------------
CREDIT_START_DATE="${CREDIT_START_DATE:-2026-10-10}"   # budget period start
CREDIT_EXPIRY="${CREDIT_EXPIRY:-2027-01-08}"           # credit expiry; days-left is computed from it
BUDGET_NAME="${BUDGET_NAME:-provex-v2-budget}"
BUDGET_USD="${BUDGET_USD:-280}"                        # of the 300 USD credit (20 USD cushion)
BUDGET_CURRENCY="${BUDGET_CURRENCY:-USD}"              # must equal the billing account currency
KILL_AT="${KILL_AT:-0.95}"                             # kill switch stops every VM at cost/budget >= this
BUDGET_WARN_FRACTION="${BUDGET_WARN_FRACTION:-0.80}"   # status.sh exits non-zero above this
BUDGET_TOPIC="${BUDGET_TOPIC:-budget-alerts}"
KILLSWITCH_FUNCTION="${KILLSWITCH_FUNCTION:-provex-killswitch}"
KILLSWITCH_SA_NAME="${KILLSWITCH_SA_NAME:-provex-killswitch}"
VM_SA_NAME="${VM_SA_NAME:-provex-vm}"

# ---- Location --------------------------------------------------------------------
REGION="${REGION:-us-central1}"
ZONE="${ZONE:-us-central1-a}"                                        # CPU VM + data disk
GPU_ZONES="${GPU_ZONES:-us-central1-a,us-central1-b,us-central1-c}"  # tried in order on stockouts

# ---- Storage ---------------------------------------------------------------------
BUCKET="${BUCKET:-gs://${PROJECT_ID}-artifacts}"
TMP_PREFIX_TTL_DAYS="${TMP_PREFIX_TTL_DAYS:-7}"            # lifecycle: delete tmp/** after N days
NONCURRENT_VERSIONS_KEEP="${NONCURRENT_VERSIONS_KEEP:-3}"  # lifecycle: keep N old versions per object
NONCURRENT_TTL_DAYS="${NONCURRENT_TTL_DAYS:-30}"           # lifecycle: drop old versions after N days

# ---- VM access & code ------------------------------------------------------------
SSH_USER="${SSH_USER:-provex}"                      # every VM is used as provex@<vm>
REPO_URL="${REPO_URL:-https://github.com/devang1304/provex.git}"
REPO_BRANCH="${REPO_BRANCH:-v2}"                    # falls back to the default branch if not on GitHub
REMOTE_REPO_DIR="${REMOTE_REPO_DIR:-/data/provex}"  # same path on every VM
CLONE_REPO_ON_BOOT="${CLONE_REPO_ON_BOOT:-1}"       # first boot: clone + git lfs pull + extract artifact.tar.gz
SYNC_METHOD="${SYNC_METHOD:-pipe}"                  # pipe = tar | gcloud compute ssh ; scp = tarball + gcloud compute scp
SYNC_MAX_FILE_MB="${SYNC_MAX_FILE_MB:-50}"          # sync skips bigger files (and every Git-LFS file)

# ---- CPU dev/test VM (stopped whenever it is idle) ----------------------------------
CPU_VM="${CPU_VM:-provex-cpu}"
CPU_MACHINE_TYPE="${CPU_MACHINE_TYPE:-e2-standard-4}"
CPU_IMAGE_FAMILY="${CPU_IMAGE_FAMILY:-ubuntu-2204-lts}"
CPU_IMAGE_PROJECT="${CPU_IMAGE_PROJECT:-ubuntu-os-cloud}"
CPU_BOOT_DISK_GB="${CPU_BOOT_DISK_GB:-50}"
BOOT_DISK_TYPE="${BOOT_DISK_TYPE:-pd-balanced}"     # G2 does not support pd-standard
INSTALL_POSTGRES="${INSTALL_POSTGRES:-0}"           # 1 = PostgreSQL 15 on /data/pg (raw CADETS ETL only)
PG_DB="${PG_DB:-tc_cadet_dataset_db}"
PG_USER="${PG_USER:-provex}"

# ---- Persistent data disk (CPU VM, mounted at /data, holds /data/provex) -------------
DATA_DISK="${DATA_DISK:-provex-data}"
DATA_DISK_DEVICE="${DATA_DISK_DEVICE:-provex-data}"   # -> /dev/disk/by-id/google-provex-data
# 50 GB is ample for the repo, the extracted artifact.tar.gz and the venv. 500 GB was the plan
# for Postgres + raw ETL (INSTALL_POSTGRES=1 only): pd-balanced bills ~0.10 USD/GB-month even
# while every VM is stopped -> 500 GB = ~50 USD/month = ~150 USD of the credit.
# Disks can be grown later (gcloud compute disks resize), never shrunk.
DATA_DISK_SIZE_GB="${DATA_DISK_SIZE_GB:-50}"
DATA_DISK_TYPE="${DATA_DISK_TYPE:-pd-balanced}"

# ---- GPU VM (Deep Learning VM image, no data disk) -----------------------------------
GPU_VM="${GPU_VM:-provex-gpu}"
GPU_PROVISIONING="${GPU_PROVISIONING:-SPOT}"          # SPOT | STANDARD (create_gpu_vm.sh --spot/--ondemand)
GPU_MACHINE_TYPE="${GPU_MACHINE_TYPE:-g2-standard-8}"
GPU_ACCELERATOR_TYPE="${GPU_ACCELERATOR_TYPE:-nvidia-l4}"
GPU_ACCELERATOR_COUNT="${GPU_ACCELERATOR_COUNT:-1}"
GPU_A100_MACHINE_TYPE="${GPU_A100_MACHINE_TYPE:-a2-highgpu-1g}"          # create_gpu_vm.sh --a100
GPU_A100_ACCELERATOR_TYPE="${GPU_A100_ACCELERATOR_TYPE:-nvidia-tesla-a100}"
GPU_IMAGE_PROJECT="${GPU_IMAGE_PROJECT:-deeplearning-platform-release}"
# Families get renamed/deprecated - create_gpu_vm.sh checks it and lists alternatives:
#   gcloud compute images list --project=deeplearning-platform-release --no-standard-images \
#     --filter="family~ubuntu-2204" --format="value(family)" | sort -u
GPU_IMAGE_FAMILY="${GPU_IMAGE_FAMILY:-common-cu124-ubuntu-2204-py310}"
GPU_BOOT_DISK_GB="${GPU_BOOT_DISK_GB:-100}"
# G2/A2 machine types have their GPU built in; current gcloud accepts a matching --accelerator
# too. Set to 0 if `instances create` rejects it.
GPU_ATTACH_ACCELERATOR_FLAG="${GPU_ATTACH_ACCELERATOR_FLAG:-1}"

# ---- Guardrails ----------------------------------------------------------------------
IDLE_MINUTES="${IDLE_MINUTES:-15}"              # watchdog powers a VM off after this much idle time
MAX_JOB_HOURS="${MAX_JOB_HOURS:-24}"            # run_job.sh refuses a larger max_hours (typo guard)
HARD_CAP="${HARD_CAP:-1}"                       # 1 = GCE max-run-duration (action STOP) before every start
HARD_CAP_GRACE_MIN="${HARD_CAP_GRACE_MIN:-20}"  # cap = job max_hours + this (boot, sync, final upload)
INTERACTIVE_MAX_HOURS="${INTERACTIVE_MAX_HOURS:-4}"  # cap for starts by ssh_vm.sh / sync_code.sh / create_*_vm.sh
READY_TIMEOUT_MIN="${READY_TIMEOUT_MIN:-25}"    # wait for the startup script (GPU driver install is slow)

# ---- Quotas --------------------------------------------------------------------------
QUOTA_JUSTIFICATION="${QUOTA_JUSTIFICATION:-Academic reproduction of a provenance-IDS paper; single GPU, short batch jobs, auto-shutdown enforced}"
REQUEST_PREEMPTIBLE_QUOTA="${REQUEST_PREEMPTIBLE_QUOTA:-1}"   # also PREEMPTIBLE-NVIDIA-{L4,A100}-GPUS

# ---- Rate table for cost ESTIMATES -----------------------------------------------------
# APPROXIMATE us-central1 list prices in USD; the billing console is the source of truth.
#   https://cloud.google.com/compute/vm-instance-pricing , .../disks-image-pricing
# Name = RATE_<machine type, '-' -> '_'>_<STANDARD|SPOT>, USD per hour, GPU included for g2/a2.
RATE_e2_micro_STANDARD=0.0084
RATE_e2_standard_4_STANDARD=0.134
RATE_e2_standard_8_STANDARD=0.268
RATE_g2_standard_8_STANDARD=0.85
RATE_g2_standard_8_SPOT=0.35
RATE_a2_highgpu_1g_STANDARD=3.67
RATE_a2_highgpu_1g_SPOT=1.20
# Storage, USD per GB-month - billed whether or not a VM runs.
RATE_DISK_pd_balanced=0.10
RATE_DISK_pd_standard=0.04
RATE_DISK_pd_ssd=0.17
RATE_GCS_STANDARD=0.020
# In-use external IPv4 address, USD per hour (only while a VM runs).
RATE_EXTERNAL_IP_H=0.005
