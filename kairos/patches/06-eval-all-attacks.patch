+def queue_anomaly_score(hl):
+    """Upstream anomaly score of a queue: product of (loss + 1) over its time windows."""
+    anomaly_score = 0
+    for hq in hl:
+        if anomaly_score == 0:
+            # Plus 1 to ensure anomaly score is monotonically increasing
+            anomaly_score = (anomaly_score + 1) * (hq['loss'] + 1)
+        else:
+            anomaly_score = (anomaly_score) * (hq['loss'] + 1)
+    return anomaly_score
+
+def window_bounds(window_name):
+    """'<begin>~<end>.txt' -> (begin, end), both '%Y-%m-%d %H:%M:%S.<9 digits>' (US/Eastern)."""
+    w_begin, w_end = window_name[:-len(".txt")].split("~")
+    return w_begin, w_end
+
+def window_overlaps(window_name, start, end):
+    """True if time window '<begin>~<end>.txt' overlaps [start, end].
+
+    start/end are '%Y-%m-%d %H:%M:%S' (US/Eastern). Window names come from
+    ns_time_to_datetime_US() ('%Y-%m-%d %H:%M:%S.<9 digits>', US/Eastern), a
+    fixed-width format, so plain string comparison is exact.
+    """
+    w_begin, w_end = window_bounds(window_name)
+    return w_begin <= end + ".000000000" and w_end >= start + ".000000000"
+
+def binary_metrics(y, y_pred):
+    """Window-level metrics; undefined ratios (e.g. on benign days) are None."""
+    n = len(y)
+    if n == 0:
+        return {"n_windows": 0}
+    tn, fp, fn, tp = (int(v) for v in confusion_matrix(y, y_pred, labels=[0, 1]).ravel())
+    precision = tp / (tp + fp) if tp + fp > 0 else None
+    recall = tp / (tp + fn) if tp + fn > 0 else None
+    if precision is None or recall is None:
+        fscore = None
+    elif precision + recall == 0:
+        fscore = 0.0
+    else:
+        fscore = 2 * (precision * recall) / (precision + recall)
+    return {
+        "n_windows": n,
+        "tp": tp,
+        "fp": fp,
+        "fn": fn,
+        "tn": tn,
+        "precision": precision,
+        "recall": recall,
+        "fscore": fscore,
+        "accuracy": (tp + tn) / n,
+        "fpr": fp / (fp + tn) if fp + tn > 0 else None,
+        "auc_val": float(roc_auc_score(y, y_pred)) if len(set(y)) == 2 else None,
+    }
