--- a/kairos_utils.py
+++ b/kairos_utils.py
@@ -52,6 +52,17 @@ def ns_time_to_datetime_US(ns):
     s += '.' + str(int(int(ns) % 1000000000)).zfill(9)
     return s
 
+def ns_time_from_datetime_US(s):
+    """
+    Inverse of ns_time_to_datetime_US() (used for the time-window file names).
+    :param s: str   format: 2013-10-10 23:40:00.000000000 (US/Eastern)
+    :return: int nano timestamp
+    """
+    tz = pytz.timezone('US/Eastern')
+    date, _, frac = s.partition('.')
+    dt = tz.localize(datetime.strptime(date, '%Y-%m-%d %H:%M:%S'))
+    return int(dt.timestamp()) * 1000000000 + (int(frac) if frac else 0)
+
 def time_to_datetime_US(s):
     """
     :param ns: int nano timestamp
