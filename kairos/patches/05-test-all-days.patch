+    # Reconstruct the edges in each day. test() resets the memory and the
+    # neighbor loader at the start of every day, exactly as upstream, so the
+    # result of a day does not depend on which other days are scored.
+    for graph_name in (args.graphs if args.graphs else test_graphs):
+        inference_data = load_data(graph_name)
+        if inference_data is None:
+            logger.info(f"{graph_name}: no graph file in {graphs_dir}, skipped")
+            continue
+        if inference_data.num_events == 0:
+            logger.info(f"{graph_name}: empty graph, skipped")
+            continue
+        logger.info(f"Reconstructing {graph_name} ({inference_data.num_events} events)")
+        test(inference_data=inference_data,
+             memory=memory,
+             gnn=gnn,
+             link_pred=link_pred,
+             neighbor_loader=neighbor_loader,
+             nodeid2msg=nodeid2msg,
+             path=artifact_dir + graph_name)
+        del inference_data
+        if torch.cuda.is_available():
+            torch.cuda.empty_cache()
