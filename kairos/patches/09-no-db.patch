+def load_nodeid2msg_json(path):
+    """index_id -> {node_type: msg} from a JSON export of node2id.
+
+    The file maps "<index_id>" to "<node_type>: <msg>" (e.g. PROVEX's
+    artifact/explanations/node_mapping.json). This is the index_id part of
+    gen_nodeid2msg(); its hash_id -> index_id entries are not available
+    (test.py only looks up index_ids).
+    """
+    with open(path, "r", encoding="utf-8") as f:
+        mapping = json.load(f)
+    nodeid2msg = {}
+    for index_id, label in mapping.items():
+        node_type, sep, msg = label.partition(": ")
+        if not sep:
+            raise ValueError(f"{path}: unexpected node label {label!r} for index_id {index_id}")
+        nodeid2msg[int(index_id)] = {node_type: msg}
+    return nodeid2msg
+
+def get_nodeid2msg():
+    """nodeid2msg from KAIROS_NODE_MAP_JSON when set, else from the database (upstream)."""
+    if node_map_json is not None:
+        return load_nodeid2msg_json(node_map_json)
+    cur, _ = init_database_connection()
+    return gen_nodeid2msg(cur=cur)
+
