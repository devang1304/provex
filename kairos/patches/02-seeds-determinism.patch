     return hasher.intdigest()
 
+def set_seed(seed):
+    """Seed python, numpy and torch (CPU and CUDA) and request deterministic kernels.
+
+    Call it before any model or CUDA tensor op is built. CUBLAS_WORKSPACE_CONFIG
+    only takes effect if set before the first cuBLAS call, and PYTHONHASHSEED
+    only affects child processes, so run_pipeline.sh exports both as well.
+    torch ops without a deterministic implementation only emit a warning
+    (warn_only=True) and torch_scatter extension kernels used by PyG are not
+    covered by the flag, so GPU runs are seeded but not guaranteed to be
+    bitwise reproducible.
+    """
+    seed = int(seed)
+    os.environ.setdefault("CUBLAS_WORKSPACE_CONFIG", ":4096:8")
+    os.environ["PYTHONHASHSEED"] = str(seed)
+    random.seed(seed)
+    np.random.seed(seed)
+    torch.manual_seed(seed)
+    torch.cuda.manual_seed_all(seed)
+    torch.backends.cudnn.deterministic = True
+    torch.backends.cudnn.benchmark = False
+    torch.use_deterministic_algorithms(True, warn_only=True)
+
+def seed_artifact_dir(seed):
+    """Artifact directory of one seeded run: <artifact_dir>seed_<n>/.
+
+    With seed=None the upstream layout (<artifact_dir> itself) is kept. The
+    vectorized graphs (graphs_dir) stay shared by all seeds.
+    """
+    if seed is None:
+        return artifact_dir
+    return artifact_dir + "seed_" + str(seed) + "/"
+
+def seed_arg_parser(description):
+    """argparse parser with the --seed option shared by all pipeline scripts."""
+    parser = argparse.ArgumentParser(description=description)
+    parser.add_argument("--seed", type=int, default=None,
+                        help="random seed; outputs go to <artifact_dir>seed_<n>/ "
+                             "(default: unseeded, upstream artifact layout)")
+    return parser
+
 
 
 
